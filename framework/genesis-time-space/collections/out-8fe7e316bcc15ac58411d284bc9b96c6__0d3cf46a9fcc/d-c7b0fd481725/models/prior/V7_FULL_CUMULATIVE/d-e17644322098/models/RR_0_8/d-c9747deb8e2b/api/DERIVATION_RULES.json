{
  "schema": "ASTRAEUS_RAINBOW_ROAD_DERIVATION_RULES_V2",
  "policy": {
    "outputs_default_to_candidates": true,
    "internal_auto_promotion": true,
    "auto_promotion_requires": "VALID Closure Certificate under CLOSURE_CONTRACT.json",
    "domain_extensions_auto_promote": false,
    "provenance_required": true,
    "circularity_guard": "No certificate may depend evidentially on its own output through an unbroken cycle."
  },
  "rules": [
    {
      "rule_id": "R-001",
      "name": "handoff_composition_candidate",
      "kind": "graph_pattern",
      "when": [
        "X HANDOFF_TO Y",
        "Y HANDOFF_TO Z"
      ],
      "propose": [
        "X HANDOFF_TO Z"
      ],
      "requirements": [
        "compatibility proof across both handoffs"
      ],
      "status": "ENABLED_CANDIDATE_ONLY"
    },
    {
      "rule_id": "R-002",
      "name": "recovery_witness_component_lattice",
      "kind": "frontier_macro",
      "when": [
        "frontier=@object_resolution_recovery_witness_minimality"
      ],
      "propose_objects": [
        "@witness_bundle_core",
        "@witness_bundle_history_augmented",
        "@witness_bundle_full_state_fallback"
      ],
      "status": "ENABLED_CANDIDATE_ONLY"
    },
    {
      "rule_id": "R-003",
      "name": "interface_defect_requires_selector",
      "kind": "graph_pattern",
      "when": [
        "@bandwidth_resolution_interface_defect OCCURS_AT_INTERFACE_OF @resolution_readout",
        "@handoff_merge_fiber MOTIVATES @recovery_provenance_bundle"
      ],
      "propose_objects": [
        "@fine_lineage_selector"
      ],
      "status": "ENABLED_CANDIDATE_ONLY"
    },
    {
      "rule_id": "R-004",
      "name": "native_cross_branch_synthesis",
      "kind": "frontier_macro",
      "when": [
        "active frontier touches >=2 native branches"
      ],
      "propose": [
        "cross_branch_synthesis_task"
      ],
      "status": "ENABLED_CANDIDATE_ONLY"
    },
    {
      "rule_id": "R-005",
      "name": "domain_boundary_firewall",
      "kind": "audit",
      "when": [
        "generated result changes domain contract or introduces primitive/axiom/unlicensed transformation"
      ],
      "propose": [
        "DOMAIN_EXTENSION_PROPOSAL"
      ],
      "status": "ALWAYS_ON"
    },
    {
      "rule_id": "R-006",
      "name": "closure_certificate_self_promotion",
      "kind": "closure",
      "when": [
        "candidate has VALID Closure Certificate",
        "all certificate obligations true"
      ],
      "propose": [
        "promote candidate to DERIVED_CLOSED_INTERNAL"
      ],
      "status": "AUTO_CLOSURE_ELIGIBLE"
    },
    {
      "rule_id": "R-007",
      "name": "mobius_closure_equivariance_audit",
      "kind": "audit",
      "when": [
        "result has typed H action or orientation scope"
      ],
      "propose": [
        "compare Cl_RR(H(x)) with H(Cl_RR(x)) under declared equivalence; record defect rather than force equality"
      ],
      "status": "ALWAYS_ON"
    },
    {
      "rule_id": "R-008",
      "name": "recursive_perturbation_impact",
      "kind": "sandbox",
      "when": [
        "perturbation injected"
      ],
      "propose": [
        "compute dependency impact cone",
        "invalidate affected certificates",
        "iterate reclosure in isolated branch",
        "report conflicts/forks"
      ],
      "status": "SANDBOX_ONLY"
    },
    {
      "rule_id": "R-009",
      "name": "witness_fiber_separation",
      "kind": "recovery",
      "when": [
        "non-injective handoff fiber declared",
        "retained witness map declared"
      ],
      "propose": [
        "test witness collisions on each recovery-relevant merge fiber",
        "promote fiber-separation criterion with valid certificate"
      ],
      "status": "AUTO_CLOSURE_ELIGIBLE"
    },
    {
      "rule_id": "R-010",
      "name": "core_witness_counterexample",
      "kind": "counterexample",
      "when": [
        "two distinct fine lineages share one coarse readout",
        "core witness projections coincide"
      ],
      "propose": [
        "record @core_witness_collision",
        "mark unqualified universal core sufficiency false"
      ],
      "status": "AUTO_CLOSURE_ELIGIBLE"
    },
    {
      "rule_id": "R-011",
      "name": "minimal_recovery_discriminator",
      "kind": "recovery",
      "when": [
        "witness collision found"
      ],
      "propose": [
        "introduce derived @recovery_discriminator role",
        "test existing source-backed History/holonomy components before adding new structure"
      ],
      "status": "AUTO_CLOSURE_ELIGIBLE"
    },
    {
      "rule_id": "R-012",
      "name": "history_counterexample_repair",
      "kind": "recovery",
      "when": [
        "colliding lineages have distinct retained ordered History"
      ],
      "propose": [
        "test History-augmented bundle for separation",
        "do not promote full History as globally minimal from one counterexample"
      ],
      "status": "AUTO_CLOSURE_ELIGIBLE"
    }
  ]
}
