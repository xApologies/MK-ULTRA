digraph G { graph [bgcolor="#07111f",rankdir=LR,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f"]; X0 [label="x0\nFormal Identity"]; H1 [label="history h1"]; W1 [label="Identity Witness"]; X1 [label="x1"]; H2 [label="history h2"]; W2 [label="Identity Witness"]; X2 [label="x2"]; P [label="Witness-chain\npersistence"]; X0->H1->X1->H2->X2; H1->W1; H2->W2; W1->P; W2->P;}