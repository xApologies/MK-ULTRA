digraph G { graph [bgcolor="#07111f",rankdir=LR,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f"]; S [label="readable start\nRead_R(x)"]; H [label="closed History loop\ngamma_H"]; E [label="readable end\n~ Read_R(x)"]; C [label="chirality holonomy"]; I [label="Identity holonomy"]; D [label="hidden Identity break\nif nontrivial + uncompensated"]; S->H->E; H->C->I->D;}