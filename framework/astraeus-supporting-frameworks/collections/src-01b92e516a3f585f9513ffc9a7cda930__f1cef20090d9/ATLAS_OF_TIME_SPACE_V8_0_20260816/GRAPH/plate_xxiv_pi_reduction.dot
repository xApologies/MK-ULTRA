digraph G { graph [bgcolor="#07111f",rankdir=LR,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f",fontname="Helvetica"]; C [label="configuration c"]; R [label="r_π(c)\n(r_π)^2=id"]; W [label="π-equivariant weights\nw(rπc,rπd)=w(c,d)"]; Comm [label="L_U R_π = R_π L_U"]; P [label="P_+=(I+R_π)/2"]; H [label="π-even Helicon sector"]; C->R; R->W; W->Comm; Comm->P; P->H;}