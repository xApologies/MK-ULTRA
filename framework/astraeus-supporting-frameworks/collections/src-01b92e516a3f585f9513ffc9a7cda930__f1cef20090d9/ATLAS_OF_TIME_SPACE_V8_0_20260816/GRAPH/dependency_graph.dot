digraph Atlas {
rankdir=LR;
graph [bgcolor="white"];
node [shape=box, style="rounded"];
prime [label="Prime boundary 0|0"];
boundary [label="Boundary / address"];
T5 [label="Time-Space T5"];
S3 [label="S3 continuity"];
S2 [label="Localized S2 projection"];
chi [label="Global chirality"];
chip [label="Local chirality chi_p"];
gamma [label="Path gamma in S3"];
corridor [label="Corridor W_gamma=S2xI"];
transport [label="Chirality transport"];
timeshell [label="Time-Shell readout"];
qft [label="QFT_p"];
gr [label="GR_p"];
er [label="ER_p"];
helicon [label="Helicon"];
graviton [label="Graviton"];
metric [label="Metric/curvature"];
energy [label="Energy invariant"];
prime -> boundary [label="generates address"];
boundary -> timeshell [label="scales to readout boundary"];
T5 -> S3 [label="projects to continuity base"];
T5 -> S2 [label="has localized fibers"];
chi -> chip [label="restricts to local projection"];
S3 -> gamma [label="admits path"];
gamma -> corridor [label="pullback induces"];
T5 -> corridor [label="pullback source"];
chip -> qft [label="rho_Q"];
chip -> gr [label="rho_G"];
chip -> er [label="rho_ER"];
chi -> transport [label="global organization"];
gamma -> transport [label="defines route"];
transport -> corridor [label="acts through"];
corridor -> timeshell [label="arrives at boundary readout"];
er -> helicon [label="supports local modes"];
helicon -> graviton [label="gravitational mode projects"];
graviton -> metric [label="Time-Shell / perturbation route"];
metric -> gr [label="readable GR"];
energy -> qft [label="representation"];
energy -> gr [label="representation"];
}
