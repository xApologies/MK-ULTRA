digraph G { graph [bgcolor="#07111f",rankdir=LR,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f",fontname="Helvetica"]; U [label="Γ_U\nUnit-String configuration graph"]; P [label="equitable Helicon partition\nC₁...C_m"]; LU [label="L_U"]; LH [label="L_H^Q\nquotient spectral operator"]; Q [label="lift Q\nclass-constant amplitudes"]; E [label="L_U Q = Q L_H^Q"]; R [label="Helicon-readable modes\nSpec(L_H^Q) ⊆ Spec(L_U)"]; X [label="hidden intra-class\nconfiguration modes"]; U->LU; U->P; P->LH; LH->Q; LU->E; Q->E; E->R; U->X [style=dashed];}