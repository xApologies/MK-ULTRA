{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRANE Response Envelope",
  "type": "object",
  "required": [
    "request_id",
    "status"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "artifact": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        },
        "checksum_sha256": {
          "type": "string"
        }
      }
    },
    "validation_receipt": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
