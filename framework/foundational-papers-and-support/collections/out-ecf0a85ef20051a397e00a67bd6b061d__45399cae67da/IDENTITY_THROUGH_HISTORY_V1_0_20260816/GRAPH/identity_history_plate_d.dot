digraph G { graph [bgcolor="#07111f",rankdir=LR,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f"]; S3A [label="S3 address p_alpha"]; H [label="History / corridor\nWitness + chirality transport"]; S3B [label="S3 address p_beta"]; S2A [label="S2 readout alpha"]; S2B [label="S2 readout beta"]; S3A->H->S3B; S3A->S2A [label="readout"]; S3B->S2B [label="readout"]; H->S2B [style=dashed,label="history residue"]; }