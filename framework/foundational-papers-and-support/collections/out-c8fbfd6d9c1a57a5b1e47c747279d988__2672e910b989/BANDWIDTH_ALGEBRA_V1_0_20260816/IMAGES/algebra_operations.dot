digraph G {
  rankdir=TB;
  graph [label="Bandwidth Algebra v1.0 — Native Operations", labelloc=t, fontsize=22];
  node [shape=box, style="rounded", fontsize=12];
  AB [label="A_B\nFormal Bandwidth Algebra"];
  Gen [label="Gen(B)\ntyped available generators"];
  Comp [label="Composition\nb o a"];
  Rest [label="Restriction\nA_B' -> A_B"];
  Exp [label="Expansion\nA_B -> A_B+"];
  Join [label="Join / Meet\ncombined/shared freedom"];
  Mod [label="Modifiers\noccupancy / artifact / persistence"];
  Res [label="Resolution readout\nrho_R"];
  Sat [label="Saturation\nFree_B(x)=empty"];
  Gen -> AB;
  AB -> Comp;
  AB -> Rest;
  AB -> Exp;
  AB -> Join;
  AB -> Mod;
  AB -> Res;
  AB -> Sat;
}
