digraph G { graph [bgcolor="#07111f",rankdir=TB,pad=.3]; node [shape=box,style="rounded,filled",fillcolor="#10243b",fontcolor="#f4d18b",color="#8db5d9",fontname="Helvetica"]; edge [color="#dfb85f",fontcolor="#dfb85f"]; C [label="Chirality"]; A [label="Adjacency"]; P [label="Propagation"]; M [label="Continuity memory"]; I [label="Persistence / Identity witness"]; H [label="Interaction History"]; TS [label="Time Shell\npersistent history readout"]; T [label="Readable temporal ordering"]; C->A->P->M->I->H->TS->T;}